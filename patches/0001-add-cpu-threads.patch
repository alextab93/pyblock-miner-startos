+fn fmt_hashrate(ghs: f64) -> String {
+    let value = ghs.max(0.0);
+    if value >= 1.0 { format!("{:.2} GH/s", value) }
+    else if value >= 0.001 { format!("{:.2} MH/s", value * 1_000.0) }
+    else if value >= 0.000001 { format!("{:.2} kH/s", value * 1_000_000.0) }
+    else if value > 0.0 { format!("{:.2} H/s", value * 1_000_000_000.0) }
+    else { "0 H/s".into() }
+}
