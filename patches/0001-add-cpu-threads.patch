+fn dashboard_http_response(method: &str, request_path: &str, st: &Stats) -> Vec<u8> {
+    let path = request_path.split('?').next().unwrap_or(request_path);
+    let (status, content_type, body) = if method != "GET" && method != "HEAD" {
+        ("405 Method Not Allowed", "text/plain; charset=utf-8", b"Method not allowed".to_vec())
+    } else {
+        match path {
+            "/" | "/index.html" => ("200 OK", "text/html; charset=utf-8", DASHBOARD_HTML.to_vec()),
+            "/app.css" => ("200 OK", "text/css; charset=utf-8", DASHBOARD_CSS.to_vec()),
+            "/app.js" => ("200 OK", "text/javascript; charset=utf-8", DASHBOARD_JS.to_vec()),
+            "/icon.svg" => ("200 OK", "image/svg+xml", DASHBOARD_ICON.to_vec()),
+            "/api/status" => ("200 OK", "application/json; charset=utf-8", serde_json::to_vec(&dashboard_status(st)).unwrap_or_else(|_| b"{}".to_vec())),
+            _ => ("404 Not Found", "text/plain; charset=utf-8", b"Not found".to_vec()),
+        }
+    };
+    let headers = format!(
+        "HTTP/1.1 {}\r\nContent-Type: {}\r\nContent-Length: {}\r\nCache-Control: no-store\r\nContent-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'\r\nReferrer-Policy: no-referrer\r\nX-Content-Type-Options: nosniff\r\nX-Frame-Options: DENY\r\nConnection: close\r\n\r\n",
+        status, content_type, body.len()
+    );
+    let mut response = headers.into_bytes();
+    if method != "HEAD" { response.extend_from_slice(&body); }
+    response
+}
+
+fn handle_dashboard_connection(mut stream: TcpStream, stats: &Arc<Mutex<Stats>>) {
+    let _ = stream.set_read_timeout(Some(Duration::from_secs(2)));
+    let _ = stream.set_write_timeout(Some(Duration::from_secs(2)));
+    let mut request = [0u8; 8192];
+    let read = match stream.read(&mut request) {
+        Ok(read) if read > 0 => read,
+        _ => return,
+    };
+    let request_line = String::from_utf8_lossy(&request[..read]);
+    let mut parts = request_line.lines().next().unwrap_or_default().split_whitespace();
+    let method = parts.next().unwrap_or_default();
+    let path = parts.next().unwrap_or_default();
+    let response = if method.is_empty() || path.is_empty() {
+        b"HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n".to_vec()
+    } else {
+        dashboard_http_response(method, path, &stats.lock().unwrap())
+    };
+    let _ = stream.write_all(&response);
+}
+
+fn spawn_dashboard(stats: Arc<Mutex<Stats>>) {
+    std::thread::spawn(move || {
+        let listener = match TcpListener::bind(("0.0.0.0", DASHBOARD_PORT)) {
+            Ok(listener) => listener,
+            Err(error) => {
+                eprintln!("Mining dashboard failed to bind on port {}: {}", DASHBOARD_PORT, error);
+                return;
+            }
+        };
+        for stream in listener.incoming() {
+            if let Ok(stream) = stream { handle_dashboard_connection(stream, &stats); }
+        }
+    });
+}
