+use std::io::{BufRead, BufReader};
+use std::process::{Command, Output, Stdio};
+
+fn command() -> Command {
+    let mut command = Command::new(env!("CARGO_BIN_EXE_pyblockMiner"));
+    command.env("XDG_CONFIG_HOME", std::env::temp_dir().join("pyblock-miner-cli-tests"));
+    command.env("PYBLOCK_DASHBOARD_DISABLED", "1");
+    command
+}
+
+fn output(args: &[&str]) -> Output {
+    command().args(args).output().expect("binary should execute")
+}
+
+fn headless_banner(requested: usize) -> String {
+    let mut child = command()
+        .args([
+            "--headless",
+            "--cpu",
+            "--cpu-threads",
+            &requested.to_string(),
+            "--network",
+            "regtest",
+            "--addr",
+            "bcrt1qtest",
+            "--pool",
+            "127.0.0.1:1",
+        ])
+        .stdout(Stdio::piped())
+        .spawn()
+        .expect("headless process should start");
+    let stdout = child.stdout.take().expect("stdout should be captured");
+    let mut line = String::new();
+    BufReader::new(stdout)
+        .read_line(&mut line)
+        .expect("headless banner should be readable");
+    child.kill().expect("headless process should stop");
+    child.wait().expect("headless process should be reaped");
+    line
+}
+
+#[test]
+fn version_is_reported() {
+    let result = output(&["--version"]);
+    assert!(result.status.success());
+    assert_eq!(String::from_utf8_lossy(&result.stdout), "pyblockMiner 0.2.18\n");
+}
+
+#[test]
+fn help_lists_cpu_threads() {
+    let result = output(&["--help"]);
+    assert!(result.status.success());
+    assert!(String::from_utf8_lossy(&result.stdout).contains("--cpu-threads <N>"));
+}
+
+#[test]
+fn zero_cpu_threads_is_rejected() {
+    let result = output(&["--cpu-threads", "0"]);
+    assert_eq!(result.status.code(), Some(2));
+    assert!(String::from_utf8_lossy(&result.stderr).contains("greater than or equal to 1"));
+}
+
+#[test]
+fn configured_cpu_threads_are_used_in_headless_mode() {
+    assert!(headless_banner(1).contains("cpu_threads=1"));
+}
+
+#[test]
+fn excessive_cpu_threads_are_clamped() {
+    let available = std::thread::available_parallelism()
+        .map(|value| value.get())
+        .unwrap_or(4);
+    assert!(headless_banner(available + 1).contains(&format!("cpu_threads={}", available)));
+}
