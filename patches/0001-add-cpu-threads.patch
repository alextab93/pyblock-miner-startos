+fn dashboard_status(st: &Stats) -> DashboardStatus {
+    let (state, state_label) = if st.paused {
+        ("paused", "Paused")
+    } else if st.connected && st.hr_total > 0.0 {
+        ("mining", "Mining")
+    } else if st.connected {
+        ("connected", "Connected")
+    } else {
+        ("waiting", "Waiting for pool")
+    };
+    let total_shares = st.accepted + st.rejected;
+    let rejection_rate = if total_shares > 0 {
+        st.rejected as f64 / total_shares as f64 * 100.0
+    } else {
+        0.0
+    };
+    let workers = st.gpu_names.iter().enumerate().map(|(index, name)| DashboardWorker {
+        name: name.clone(),
+        hashrate_hps: st.gpu_ghs.get(index).copied().unwrap_or(0.0) * 1e9,
+    }).collect();
+    DashboardStatus {
+        state: state.into(),
+        state_label: state_label.into(),
+        connected: st.connected,
+        network: st.network.clone(),
+        pool: st.endpoint.clone(),
+        payout_address: st.addr.clone(),
+        hashrate: fmt_hashrate(st.hr_total),
+        hashrate_hps: st.hr_total * 1e9,
+        worker_count: st.gpu_names.len(),
+        workers,
+        uptime_seconds: st.started.map(|started| started.elapsed().as_secs()).unwrap_or(0),
+        accepted: st.accepted,
+        rejected: st.rejected,
+        rejection_rate,
+        blocks: st.blocks,
+        best_share: fmt_diff(st.best_diff),
+        current_difficulty: if st.diff > 0.0 { fmt_diff(st.diff) } else { "Unavailable".into() },
+        pool_height: if st.net_ok && st.net_height > 0 { Some(st.net_height) } else { None },
+        pool_miners: if st.net_ok { Some(st.net_miners) } else { None },
+        pool_hashrate: if st.net_ok { fmt_hashrate(st.net_ghs) } else { "Unavailable".into() },
+        hashrate_history_hps: st.dashboard_hist.iter().map(|value| value * 1e9).collect(),
+        events: st.log.iter().rev().take(10).cloned().collect(),
+    }
+}
